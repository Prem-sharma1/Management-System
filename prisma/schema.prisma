generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String
  password      String
  role          String
  department    String
  salary        Float          @default(0.0)
  status        String         @default("ACTIVE")
  avatar        String?
  createdAt     DateTime       @default(now())
  attendance    Attendance[]
  leaveRequests LeaveRequest[]
  assignedTasks Task[]         @relation("AssignedTasks")
  createdTasks  Task[]         @relation("CreatedTasks")
}

model Attendance {
  id        Int       @id @default(autoincrement())
  userId    Int
  clockIn   DateTime
  clockOut  DateTime?
  status    String
  date      String
  location  String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id        Int      @id @default(autoincrement())
  userId    Int
  startDate String
  endDate   String
  reason    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?
  status        String   @default("TODO")
  assignedToId  Int
  createdById   Int
  dueDate       String?
  createdAt     DateTime @default(now())
  priority      String   @default("Normal")
  reason        String?
  workSampleUrl String?
  assignedTo    User     @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdBy     User     @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
}

model AuditLog {
  id              Int      @id @default(autoincrement())
  action          String
  performedByName String
  performedByRole String
  createdAt       DateTime @default(now())
}

model Client {
  id             Int              @id @default(autoincrement())
  clientId       String           @unique
  businessName   String
  clientName     String?
  joiningDate    String
  services       String
  packageName    String
  packageAmount  Float
  contact        String?
  email          String?
  website        String?
  sector         String?
  requirement    String?
  accountReady   Boolean          @default(false)
  active         Boolean          @default(true)
  notes          String?
  createdAt      DateTime         @default(now())
  ClientDelivery ClientDelivery[]
  ClientTask     ClientTask[]
}

model ClientDelivery {
  id           Int      @id @default(autoincrement())
  deliveryId   String   @unique
  clientId     String
  clientName   String
  postType     String
  postDate     String
  status       String   @default("Pending")
  linkedTaskId String?
  workingOn    String?
  notes        String?
  createdAt    DateTime @default(now())
  Client       Client   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
}

model ClientTask {
  id            Int      @id @default(autoincrement())
  taskId        String   @unique
  clientId      String
  businessName  String
  taskTitle     String
  date          String
  assignTo      String?
  workingOn     String?
  status        String   @default("Not Started")
  service       String?
  packageName   String?
  postType      String?
  notes         String?
  createdAt     DateTime @default(now())
  priority      String   @default("Normal")
  reason        String?
  workSampleUrl String?
  Client        Client   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
}

model Plan {
  id           Int      @id @default(autoincrement())
  category     String
  name         String
  price        Float
  billingCycle String?
  features     Json
  createdAt    DateTime @default(now())
}
